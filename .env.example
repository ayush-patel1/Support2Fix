# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=support2fix
POSTGRES_PASSWORD=support2fix
POSTGRES_DB=support2fix
REPOSITORIES_PATH=.

# Used by apps/api when run OUTSIDE Docker Compose (e.g. `uvicorn` directly).
# Inside Compose, api's DATABASE_URL is set from the POSTGRES_* vars above
# instead (see docker-compose.yml), pointing at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://support2fix:support2fix@localhost:5432/support2fix

# --- API ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
# Session cookie's Secure flag defaults to (ENVIRONMENT == production), so
# it's off for local http:// dev and on wherever TLS terminates in front of
# the API. Leave unset unless you need to force it either way.
# SESSION_COOKIE_SECURE=true

# --- Frontend ------------------------------------------------------------
# Where apps/web proxies /api/* to, when run OUTSIDE Docker Compose.
# Inside Compose this is overridden to http://api:8000 (see docker-compose.yml).
API_ORIGIN=http://localhost:8000

# --- Investigation worker / MCP ---------------------------------------------
MCP_SERVER_URL=http://localhost:8100/mcp

# --- LLM diagnosis -----------------------------------------------------------
# Set live only when configured; ticket/evidence data is never sent externally
# unless LLM_ALLOW_EXTERNAL_DATA=true is explicitly enabled.
LLM_MODE=fake
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_ALLOW_EXTERNAL_DATA=false
GEMINI_API_KEY=

# --- Optional: GitHub App provider ------------------------------------------
# Install the GitHub App only on the repositories this organization needs.
# Configure the PEM key as a local-only environment variable or mounted secret.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_API_URL=https://api.github.com

# --- tools (Phase 7 MCP server, agent-architecture.md §5) -------------------
# The worker authenticates to `tools` with this shared secret — standing in
# for a real short-lived service token until there's a token issuer (a
# later infra phase). Change it before this ever leaves localhost.
MCP_SERVICE_TOKEN=dev-local-service-token
