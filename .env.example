# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=support2fix
POSTGRES_PASSWORD=support2fix
POSTGRES_DB=support2fix

# Used by apps/api when run OUTSIDE Docker Compose (e.g. `uvicorn` directly).
# Inside Compose, api's DATABASE_URL is set from the POSTGRES_* vars above
# instead (see docker-compose.yml), pointing at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://support2fix:support2fix@localhost:5432/support2fix

# --- API ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Frontend ------------------------------------------------------------
# Where apps/web proxies /api/* to, when run OUTSIDE Docker Compose.
# Inside Compose this is overridden to http://api:8000 (see docker-compose.yml).
API_ORIGIN=http://localhost:8000

# --- LLM (agents.md §7) — not used until Phase 9 ----------------------------
# live: calls Claude for real (needs ANTHROPIC_API_KEY).
# replay: replays recorded responses — deterministic demo, no key required.
# fake: scripted responses for unit tests.
LLM_MODE=fake
ANTHROPIC_API_KEY=

# --- Optional: real GitHub integration (ADR-001 D13) ------------------------
# Leave unset to use the local git adapter (default, no account needed).
# Set to a fine-grained PAT (contents: write, pull requests: write) scoped
# to one test repository to open real pull requests instead.
GITHUB_TOKEN=
